# Base of the admin API the runner calls. Dev account today; switch only when prod is approved.
ACADEMY_ADMIN_BASE_URL=https://spotclm-academy.pages.dev/api/admin

# Create in Admin > Service Keys with the "academy" permission. Shown once; store it here only.
ACADEMY_SERVICE_API_KEY=sk_replace_me

# Needed once /api/admin/* is gated by Cloudflare Access (ISS-013). Leave empty until then.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- AI providers (any subset). Keys live only on the runner. Use NEW keys: the ones in .dev.vars must be rotated (ISS-014).
GEMINI_API_KEY=replace_me
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # also works for any OpenAI-compatible host: set OPENAI_BASE_URL
OPENAI_BASE_URL=
CF_ACCOUNT_ID=             # Cloudflare Workers AI (free daily allowance), for cheap/fast steps
CF_API_TOKEN=

# --- Routing: first configured provider that answers wins; the rest are fallbacks.
# Format provider:model,provider:model. An empty AI_REVIEW disables the second-opinion pass.
AI_DRAFT=gemini:gemini-2.5-flash
AI_REVIEW=
# Example with review by a different vendor:
# AI_REVIEW=anthropic:claude-haiku-5-5

POLL_INTERVAL_MS=10000
