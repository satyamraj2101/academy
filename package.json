{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:pages": "vite build && node scripts/prerender.mjs",
    "deploy:dev": "npx wrangler pages deploy dist --project-name spotclm",
    "deploy:prod": "npx wrangler pages deploy dist --project-name spotclm-academy --branch main",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
